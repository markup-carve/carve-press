{
  "name": "@markup-carve/carve-press",
  "version": "0.1.0",
  "description": "Static site generator for the Carve markup language",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "carve-press": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "theme/default.css",
    "theme/playground.js",
    "theme/search.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "carve",
    "static-site-generator",
    "ssg",
    "markup",
    "documentation"
  ],
  "author": "Mark Scherer",
  "support": {
    "issues": "https://github.com/markup-carve/carve-press/issues",
    "source": "https://github.com/markup-carve/carve-press"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@markup-carve/carve": "github:markup-carve/carve-js#ef45a7484348e4d1cd84c1061e0b774038b16115",
    "@markup-carve/carve-grammars": "github:markup-carve/carve-grammars",
    "minisearch": "^7.2.0",
    "shiki": "^1.24.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
